# ============================================================
# JANE COSMETICS - ENVIRONMENT
# ============================================================
# Keep this file private. Do not commit it to GitHub.

DJANGO_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY
DJANGO_DEBUG=1

# ============================================================
# BEEM AFRICA SMS CENTER
# ============================================================
BEEM_API_KEY=YOUR_BEEM_API_KEY
BEEM_SECRET_KEY=YOUR_BEEM_SECRET_KEY

# Must be a Sender ID already approved in your Beem account.
BEEM_SENDER_ID=JANE

BEEM_SEND_URL=https://apisms.beem.africa/v1/send
BEEM_BALANCE_URL=https://apisms.beem.africa/public/v1/vendors/balance
BEEM_TIMEOUT=20
BEEM_SMS_BATCH_SIZE=50
SMS_MAX_RECIPIENTS_PER_SEND=500

# Protects the delivery-report endpoint /sms/dlr/
BEEM_DLR_TOKEN=CHANGE_THIS_TO_A_LONG_RANDOM_DLR_TOKEN
